# Laravel root – sits in public_html on cPanel shared hosting.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # SSL/ACME checks must pass through
    RewriteRule ^\.well-known/ - [L]

    # Redirect www -> non-www
    RewriteCond %{HTTP_HOST} ^www\.multitechpos\.com [NC]
    RewriteRule ^(.*)$ https://multitechpos.com/$1 [R=301,L]

    # Strip /public from the URL (redirect browser, keep same path)
    RewriteCond %{REQUEST_URI} ^/public(/.*)?$ [NC]
    RewriteRule ^public(/.*)?$ /$1 [R=301,L]

    # Block direct access to sensitive files and folders
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(/|$) - [F,L]
    RewriteRule ^(artisan|composer\.(json|lock)|package\.json|phpunit\.xml)$ - [F,L]

    # Redirect old ?item= URLs
    RewriteCond %{QUERY_STRING} ^item= [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    # Route everything through public/index.php
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "\.(env|git|gitignore|gitattributes|editorconfig)$">
    Require all denied
</FilesMatch>
