<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Redirect www -> non-www
    RewriteCond %{HTTP_HOST} ^www\.multitechpos\.com [NC]
    RewriteRule ^(.*)$ https://multitechpos.com/$1 [R=301,L]

    # Strip /public from URL (document root is public_html/public)
    RewriteCond %{THE_REQUEST} \s/public(/[^\s?]*)? [NC]
    RewriteRule ^public(/.*)?$ /$1 [R=301,L]

    # Redirect ?item... (query string) to home
    RewriteCond %{QUERY_STRING} ^item [NC]
    RewriteRule ^ / [R=301,L]

    # Redirect path-style ?item/... (e.g. /?item/123) to home
    RewriteCond %{THE_REQUEST} \s/\?item [NC]
    RewriteRule ^ / [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Send all requests to Laravel front controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
