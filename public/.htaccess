<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Redirect www to non-www
    RewriteCond %{HTTP_HOST} ^www\.multitechpos\.com [NC]
    RewriteRule ^(.*)$ https://multitechpos.com$1 [R=301,L]

    # Redirect /public/ URLs to clean URLs (301)
    RewriteCond %{THE_REQUEST} \s/+public(?:/|\?|\s) [NC]
    RewriteRule ^public(?:/(.*))?$ /$1 [R=301,L]

    # Redirect old /index.php?item= URLs to home page (301)
    RewriteCond %{QUERY_STRING} ^item= [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Page URLs keep their trailing slash (handled by App\Http\Middleware\AddTrailingSlash),
    # so Laravel's default "remove trailing slash" redirect is not used here.

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
